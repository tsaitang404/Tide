# Replace with an actually published, tested version or immutable sha256 digest.
GENETICGRID_IMAGE=ghcr.io/tsaitang404/tide:vX.Y.Z
# Generate each separately: openssl rand -hex 32
DJANGO_SECRET_KEY=
# Use hex characters here so the PostgreSQL URL needs no percent encoding.
POSTGRES_PASSWORD=
ALLOWED_HOSTS=localhost,127.0.0.1
BIND_ADDRESS=127.0.0.1
PORT=8000
# Off until explicitly enabled after deployment validation.
REALTIME_INGESTION_AUTO_START=false
DB_RETENTION_DAYS=30

# Public market viewer: control plane is unavailable, no exchange keys required.
TIDE_PUBLIC_READ_ONLY=true
# Enable only with a trusted local HTTPS reverse proxy and loopback binding.
TIDE_HTTPS_PROXY=false
